# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key (server-side only; do not use a NEXT_PUBLIC_ prefix)
DIFY_API_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=
# APP type
# true for workflow apps
NEXT_PUBLIC_APP_TYPE_WORKFLOW=
# Base URL path for the application
NEXT_PUBLIC_APP_BASE_URL_PATH=
# API prefix path for the application
NEXT_PUBLIC_API_PREFIX=
# 同一时刻最多并行执行的任务数（默认 5，用于避开 Dify 的 RPM 限制）
NEXT_PUBLIC_MAX_CONCURRENT=
