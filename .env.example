# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key (server-side only; packaged into the image with this file)
DIFY_API_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=
# APP type
# true for workflow apps
NEXT_PUBLIC_APP_TYPE_WORKFLOW=true
# Base URL path for the application
NEXT_PUBLIC_APP_BASE_URL_PATH=
# API prefix path for the application
NEXT_PUBLIC_API_PREFIX=/api
# 同一时刻最多并行执行的任务数（默认 5，用于避开 Dify 的 RPM 限制）
NEXT_PUBLIC_MAX_CONCURRENT=

# Application runtime settings, packaged into the image
BATCH_RUN_PASSWORD=
APP_PORT=3000

# Application image tag and optional Node base image source
IMAGE=mate-docker-register-cn-north-1.jcr.service.jdcloud.com/mate-customer-complaint:v4
BASE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
# Target server architecture; use linux/arm64 for ARM servers
BUILD_PLATFORM=linux/amd64
