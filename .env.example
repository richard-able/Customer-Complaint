# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key (server-side only; do not use a NEXT_PUBLIC_ prefix)
DIFY_API_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=
# APP type
# true for workflow apps
NEXT_PUBLIC_APP_TYPE_WORKFLOW=true
# Base URL path for the application
NEXT_PUBLIC_APP_BASE_URL_PATH=
# API prefix path for the application
NEXT_PUBLIC_API_PREFIX=/api

# Optional batch-run password (empty uses the application default)
BATCH_RUN_PASSWORD=

# Docker image name and host port
IMAGE=customer-complaint:latest
APP_PORT=3000

# Node base image; alternative: public.ecr.aws/docker/library/node:22-bookworm-slim
BASE_IMAGE=node:22-bookworm-slim
# Target server architecture; use linux/arm64 for ARM servers
BUILD_PLATFORM=linux/amd64
