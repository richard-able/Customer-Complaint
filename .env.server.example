# Full registry image address; use the actual ACR registry and namespace
IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/customer-complaint:v1
# Runtime secrets; these are not needed to build the image
DIFY_API_KEY=
# Empty uses the application's default batch password
BATCH_RUN_PASSWORD=
# Host port
APP_PORT=3000

# 工作台登录密码，必须配置
APP_ACCESS_PASSWORD=
